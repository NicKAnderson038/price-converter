# Dependencies
node_modules

# Build output
dist
dist-ssr

# Generated OCR runtime assets (produced by T4: npm run assets:ocr). The icon
# PNGs are committed instead (see scripts/generate-icons.mjs) so a clean CI
# checkout can build without installing Playwright.
public/ocr

# Vendored OCR sources under vendor/ocr/ ARE committed: scripts/copy-ocr-assets.mjs
# copies them into the git-ignored public/ocr/. Do not add a broad rule here that
# would cover vendor/ocr (e.g. *.onnx); no ignore rule currently matches it.

# Playwright
test-results
playwright-report

# Local files
*.local
.DS_Store
